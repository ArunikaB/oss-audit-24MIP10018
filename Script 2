#!/bin/bash
# Script 2: FOSS Package Inspector
PACKAGE="mysql-server"

# Check if the package is installed using dpkg
if dpkg -l $PACKAGE &>/dev/null; then
    echo "$PACKAGE is installed on this system."
    echo "-----------------------------------"


    dpkg -l $PACKAGE | grep "^ii" | awk '{print "Version: " $3}'
    echo "License : GPL v2 / Commercial (Dual License)"
    echo "Developer: Oracle Corporation"
else
    echo "$PACKAGE is NOT installed."
fi

echo ""

# Case statement: print philosophy note based on package name
case $PACKAGE in
    mysql-server)
        echo "Philosophy: MySQL is open source at the heart of millions of apps."
        echo "It powers Facebook, Twitter, YouTube and Wikipedia."
        echo "Its dual license model raises important questions about commercial open source."
        ;;
    apache2)
        echo "Philosophy: Apache built the open web — free for anyone to use."
        ;;
    git)
        echo "Philosophy: Git proved that open collaboration beats proprietary control."
        ;;
    firefox)
        echo "Philosophy: Firefox exists to keep the web open and free from monopoly."
        ;;
    *)
        echo "This is an open source package."
        ;;
esac
